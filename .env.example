# RFID Monitor Configuration

# Required: Base URL for Home Assistant webhook (tag ID will be appended)
WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/nfc-tag-scanned-

# Optional: Uptime Kuma push monitor URL for heartbeat checks
# UPTIME_KUMA_PUSH_URL=https://uptime.example.com/api/push/YOUR_PUSH_KEY

# Optional: Interval in seconds between heartbeat checks (default: 60)
# Must be between 10 and 3600 seconds
# HEARTBEAT_INTERVAL=60
